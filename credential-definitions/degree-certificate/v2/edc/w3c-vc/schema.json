{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Degree Certificate",
    "type": "object",
    "properties": {
        "@context": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "const": [
                "https://www.w3.org/2018/credentials/v1",
                "http://data.europa.eu/snb/model/context/edc-ap"
            ],
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
        },
        "id": {
            "type": "string",
            "format": "uri"
        },
        "type": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "const": [
                "VerifiableCredential",
                "EuropeanDigitalCredential"
            ],
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
        },
        "issuer": {
            "$ref": "#/definitions/organisation"
        },
        "issued": {
            "type": "string",
            "format": "date-time",
            "description": "Date the certificate was issued."
        },
        "issuanceDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date the certificate was issued."
        },
        "validFrom": {
            "type": "string",
            "format": "date-time",
            "description": "Date the certificate becomes valid."
        },
        "expirationDate": {
            "type": "string",
            "format": "date-time"
        },
        "credentialSubject": {
            "type": "object",
            "description": "The person the credential is about, modelled on the ELM Person class.",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the person."
                },
                "type": {
                    "type": "string",
                    "const": "Person",
                    "description": "The type of the credential subject."
                },
                "fullName": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Full name of the person."
                },
                "dateOfBirth": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date of birth."
                },
                "placeOfBirth": {
                    "$ref": "#/definitions/location",
                    "description": "Place of birth."
                },
                "identifier": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/identifier"
                    },
                    "description": "Identifiers of the person, e.g. the student number."
                },
                "contactPoint": {
                    "$ref": "#/definitions/contactPoint"
                },
                "hasClaim": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uri",
                            "description": "A unique URI identifier for the learning achievement."
                        },
                        "type": {
                            "type": "string",
                            "const": "LearningAchievement",
                            "description": "The type of the claim."
                        },
                        "title": {
                            "$ref": "#/definitions/languageMap",
                            "description": "Title of the claim in various languages."
                        },
                        "description": {
                            "$ref": "#/definitions/languageMap",
                            "description": "Description of the claim."
                        },
                        "awardedBy": {
                            "$ref": "#/definitions/awardingProcess"
                        },
                        "specifiedBy": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "format": "uri",
                                    "description": "A unique URI identifier for the Qualification."
                                },
                                "type": {
                                    "type": "string",
                                    "const": "Qualification",
                                    "description": "The type of the specification."
                                },
                                "title": {
                                    "$ref": "#/definitions/languageMap",
                                    "description": "Title in various languages."
                                }
                            },
                            "required": [
                                "id",
                                "type",
                                "title"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "required": [
                        "id",
                        "type",
                        "title",
                        "awardedBy"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "type",
                "hasClaim"
            ],
            "additionalProperties": false
        },
        "displayParameter": {
            "$ref": "#/definitions/displayParameter",
            "description": "Object that holds credential display properties"
        },
        "credentialSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "ShaclValidator2017",
                        "JsonSchema"
                    ]
                }
            },
            "required": [
                "id",
                "type"
            ]
        },
        "credentialProfiles": {
            "$ref": "#/definitions/concept",
            "description": "An object defining profiles applicable to the credential."
        }
    },
    "required": [
        "@context",
        "id",
        "type",
        "credentialSchema",
        "credentialSubject",
        "credentialProfiles",
        "issuer",
        "validFrom"
    ],
    "additionalProperties": false,
    "definitions": {
        "displayParameter": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "A unique URI identifier for the display parameter."
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "DisplayParameter"
                    ],
                    "description": "Defines the type of object."
                },
                "title": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Credential title to display on frontend"
                },
                "individualDisplay": {
                    "type": [
                        "object",
                        "array"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "A unique URI identifier for the display parameter."
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "IndividualDisplay"
                            ],
                            "description": "Defines the type of object."
                        },
                        "displayDetail": {
                            "type": [
                                "object",
                                "array"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "A unique URI identifier for the display detail."
                                },
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "DisplayDetail"
                                    ],
                                    "description": "Defines the type of object."
                                },
                                "image": {
                                    "$ref": "#/definitions/mediaObject",
                                    "description": "Logo of the credential."
                                },
                                "page": {
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "id",
                                "type",
                                "image"
                            ],
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/displayParameter/properties/individualDisplay/properties/displayDetail"
                            }
                        },
                        "language": {
                            "anyOf": [
                                {
                                    "$ref": "#/definitions/concept"
                                },
                                {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "$ref": "#/definitions/concept"
                                    }
                                }
                            ]
                        }
                    },
                    "required": [
                        "id",
                        "type",
                        "language",
                        "displayDetail"
                    ],
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/displayParameter/properties/individualDisplay"
                    }
                },
                "language": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/concept"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/concept"
                            }
                        }
                    ]
                },
                "primaryLanguage": {
                    "$ref": "#/definitions/concept"
                },
                "description": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Description of the credential."
                }
            },
            "required": [
                "id",
                "type",
                "title",
                "language"
            ]
        },
        "concept": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "A unique URI identifier for the concept."
                },
                "inScheme": {
                    "$ref": "#/definitions/conceptScheme"
                },
                "notation": {
                    "type": "string",
                    "description": "Notation for the concept."
                },
                "prefLabel": {
                    "$ref": "#/definitions/languageMap"
                },
                "type": {
                    "type": "string",
                    "const": "Concept",
                    "enum": [
                        "Concept"
                    ]
                }
            },
            "required": [
                "id",
                "type",
                "inScheme",
                "prefLabel"
            ]
        },
        "conceptScheme": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "A unique URI identifier for the concept scheme."
                },
                "type": {
                    "type": "string",
                    "const": "ConceptScheme",
                    "enum": [
                        "ConceptScheme"
                    ]
                }
            },
            "required": [
                "id",
                "type"
            ]
        },
        "languageMap": {
            "type": "object",
            "patternProperties": {
                "^[a-z]{2}$": {
                    "type": "string",
                    "description": "A string value for a specific language code."
                }
            },
            "additionalProperties": false,
            "description": "A mapping of language codes to string values."
        },
        "contactPoint": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "const": "urn:epass:contactPoint:1",
                    "description": "A unique URI identifier for the contact point."
                },
                "type": {
                    "type": "string",
                    "const": "ContactPoint",
                    "description": "The type of the contact point."
                },
                "emailAddress": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "A unique URI identifier for the email address.",
                            "pattern": "^mailto:.+"
                        },
                        "type": {
                            "type": "string",
                            "const": "Mailbox",
                            "description": "The type of the email address."
                        }
                    },
                    "required": [
                        "id",
                        "type"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "type",
                "emailAddress"
            ],
            "additionalProperties": false
        },
        "organisation": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the organisation."
                },
                "type": {
                    "type": "string",
                    "const": "Organisation",
                    "description": "The type of the organisation."
                },
                "location": {
                    "$ref": "#/definitions/location",
                    "description": "Location details of the organisation."
                },
                "logo": {
                    "$ref": "#/definitions/mediaObject",
                    "description": "Logo of the organisation."
                },
                "legalName": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Legal name of the organisation in various languages."
                },
                "registration": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uri",
                            "description": "A unique URI identifier for the legal identifier."
                        },
                        "type": {
                            "type": "string",
                            "const": "LegalIdentifier",
                            "description": "The type of the legal identifier."
                        },
                        "notation": {
                            "type": "string",
                            "description": "Notation or code for the legal identifier."
                        },
                        "spatial": {
                            "$ref": "#/definitions/concept",
                            "description": "Spatial information related to the legal identifier."
                        }
                    },
                    "required": [
                        "id",
                        "type",
                        "spatial"
                    ]
                },
                "homepage": {
                    "$ref": "#/definitions/webResource"
                },
                "eIDASIdentifier": {
                    "$ref": "#/definitions/organisation/properties/registration"
                }
            },
            "required": [
                "id",
                "type",
                "location",
                "legalName"
            ],
            "additionalProperties": false
        },
        "location": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the location."
                },
                "type": {
                    "type": "string",
                    "const": "Location",
                    "description": "The type of the location."
                },
                "address": {
                    "$ref": "#/definitions/address",
                    "description": "Address details of the location."
                },
                "description": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Location description."
                }
            },
            "required": [
                "id",
                "type",
                "address"
            ],
            "additionalProperties": false
        },
        "address": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the address."
                },
                "type": {
                    "type": "string",
                    "const": "Address",
                    "description": "The type of the address."
                },
                "countryCode": {
                    "$ref": "#/definitions/concept",
                    "description": "Country code for the address."
                },
                "fullAddress": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uri",
                            "description": "A unique URI identifier for the address."
                        },
                        "type": {
                            "type": "string",
                            "const": "Note",
                            "description": "The type of the address."
                        },
                        "noteLiteral": {
                            "$ref": "#/definitions/languageMap"
                        }
                    },
                    "required": [
                        "id",
                        "type",
                        "noteLiteral"
                    ]
                }
            },
            "required": [
                "id",
                "type",
                "countryCode"
            ],
            "additionalProperties": false
        },
        "mediaObject": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the media object."
                },
                "type": {
                    "type": "string",
                    "const": "MediaObject",
                    "description": "The type of the media object."
                },
                "content": {
                    "type": "string",
                    "description": "The content of the media object (e.g., base64 encoded data)."
                },
                "contentEncoding": {
                    "$ref": "#/definitions/concept",
                    "description": "Encoding type of the media content."
                },
                "contentType": {
                    "$ref": "#/definitions/concept",
                    "description": "MIME type of the media content."
                }
            },
            "required": [
                "id",
                "type",
                "content",
                "contentEncoding",
                "contentType"
            ],
            "additionalProperties": false
        },
        "webResource": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the web resource."
                },
                "type": {
                    "type": "string",
                    "const": "WebResource",
                    "description": "The type of the web resource."
                },
                "contentURL": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL of the web resource."
                }
            },
            "required": [
                "id",
                "type",
                "contentURL"
            ],
            "additionalProperties": false
        },
        "identifier": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the identifier."
                },
                "type": {
                    "type": "string",
                    "const": "Identifier",
                    "description": "The type of the identifier."
                },
                "notation": {
                    "type": "string",
                    "description": "The identifier value."
                },
                "schemeName": {
                    "type": "string",
                    "description": "Name of the identifier scheme, e.g. Student number."
                },
                "schemeAgency": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Agency that manages the identifier scheme."
                }
            },
            "required": [
                "id",
                "type",
                "notation"
            ],
            "additionalProperties": false
        },
        "note": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the note."
                },
                "type": {
                    "type": "string",
                    "const": "Note",
                    "description": "The type of the note."
                },
                "noteLiteral": {
                    "$ref": "#/definitions/languageMap",
                    "description": "Note text in various languages."
                }
            },
            "required": [
                "id",
                "type",
                "noteLiteral"
            ],
            "additionalProperties": false
        },
        "awardingProcess": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "const": "urn:epass:awardingProcess:1",
                    "format": "uri",
                    "description": "A unique URI identifier for the awarding process."
                },
                "type": {
                    "type": "string",
                    "const": "AwardingProcess",
                    "description": "The type of the awarding process."
                },
                "awardingBody": {
                    "$ref": "#/definitions/organisation"
                }
            },
            "required": [
                "id",
                "type",
                "awardingBody"
            ],
            "additionalProperties": false
        },
        "creditPoint": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uri",
                    "description": "A unique URI identifier for the credit points."
                },
                "type": {
                    "type": "string",
                    "const": "CreditPoint",
                    "description": "The type of the credit points."
                },
                "framework": {
                    "$ref": "#/definitions/concept",
                    "description": "Credit system, e.g. ECTS."
                },
                "point": {
                    "type": "string",
                    "description": "Number of credit points."
                }
            },
            "required": [
                "id",
                "type",
                "framework",
                "point"
            ],
            "additionalProperties": false
        }
    }
}
