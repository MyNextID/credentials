{
    "/name": "input.achievementTitle[?meta.primaryLanguage].orValue(input.achievementTitle.en)",
    "/credentialSubject/achievement/name": "input.achievementTitle[?meta.primaryLanguage].orValue(input.achievementTitle.en)",
    "/credentialSubject/achievement/description": "has(input.achievementDescription) ? input.achievementDescription[?meta.primaryLanguage].orValue(input.achievementDescription.en) : input.achievementTitle[?meta.primaryLanguage].orValue(input.achievementTitle.en)",
    "/credentialSubject/achievement/achievementType": "'MicroCredential'",
    "/credentialSubject/achievement/creditsAvailable": "double(input.ectsPoints)",
    "/credentialSubject/achievement/criteria/narrative": "input.title[?meta.primaryLanguage].orValue(input.title.en)",
    "/credentialSubject/result": "[{'type': ['Result'], 'value': input.gradeAchieved[?meta.primaryLanguage].orValue(input.gradeAchieved.en)}]"
}
