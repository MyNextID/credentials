{
    "/credentialSubject/fullName": "input.?fullName",
    "/credentialSubject/dateOfBirth": "input.?dateOfBirth",
    "/credentialSubject/placeOfBirth": "{'id': 'urn:epass:location:' + uuid(), 'type': 'Location', 'address': {'id': 'urn:epass:address:' + uuid(), 'type': 'Address', 'countryCode': vocab.country[input.placeOfBirth.en], 'fullAddress': {'id': 'urn:epass:note:' + uuid(), 'type': 'Note', 'noteLiteral': input.fullAddress}}}",
    "/credentialSubject/identifier": "[['Student number', input.?studentNumber.orValue('')]].filter(p, p[1] != '').map(p, {'id': 'urn:epass:identifier:' + uuid(), 'type': 'Identifier', 'schemeName': p[0], 'notation': p[1], 'schemeAgency': meta.?awardingBody.orValue(meta.issuer).legalName})",
    "/credentialSubject/hasClaim/id": "'urn:epass:learningActivity:' + uuid()",
    "/credentialSubject/hasClaim/type": "'LearningActivity'",
    "/credentialSubject/hasClaim/title": "input.programmeTitle",
    "/credentialSubject/hasClaim/workload": "input.?workload",
    "/credentialSubject/hasClaim/specifiedBy": "{'id': 'urn:epass:learningActivitySpecification:' + uuid(), 'type': 'LearningActivitySpecification', 'title': input.programmeTitle, 'dcType': vocab.learningActivityType['educational programme']}",
    "/credentialSubject/hasClaim/additionalNote": "[['Academic year', input.?academicYear.orValue('')]].filter(p, p[1] != '').map(p, {'id': 'urn:epass:note:' + uuid(), 'type': 'Note', 'noteLiteral': {'en': p[0] + ': ' + p[1]}})"
}
