{
    "/issuanceDate": "input.?issuanceDate.orValue(now)",
    "/expirationDate": "has(input.validUntil) ? optional.of(input.validUntil) : meta.?validUntil",
    "/credentialSubject/fullName": "input.?fullName",
    "/credentialSubject/dateOfBirth": "input.?dateOfBirth",
    "/credentialSubject/citizenshipCountry": "has(input.nationality) ? optional.of(vocab.country[input.nationality.en]) : optional.none()",
    "/credentialSubject/passportNumber": "input.?passportNumber",
    "/credentialSubject/visaNumber": "input.?visaNumber",
    "/credentialSubject/typeOfVisa": "input.?typeOfVisa",
    "/credentialSubject/placeOfIssue": "input.?placeOfIssue",
    "/credentialSubject/entryType": "input.?entryType",
    "/credentialSubject/durationOfStay": "input.?durationOfStay"
}
