{
    "/vct": "'urn:mynextid:visa:2'",
    "/full_name": "input.fullName[?meta.primaryLanguage].orValue(input.fullName.en)",
    "/date_of_birth": "input.?dateOfBirth",
    "/nationality": "has(input.nationality) ? optional.of(vocab.countryCode[input.nationality.en]) : optional.none()",
    "/passport_number": "input.?passportNumber",
    "/visa_number": "input.?visaNumber",
    "/type_of_visa": "has(input.typeOfVisa) ? optional.of(input.typeOfVisa[?meta.primaryLanguage].orValue(input.typeOfVisa.en)) : optional.none()",
    "/entry_type": "has(input.entryType) ? optional.of(input.entryType[?meta.primaryLanguage].orValue(input.entryType.en)) : optional.none()",
    "/place_of_issue": "has(input.placeOfIssue) ? optional.of(input.placeOfIssue[?meta.primaryLanguage].orValue(input.placeOfIssue.en)) : optional.none()",
    "/duration_of_stay": "input.?durationOfStay",
    "/date_of_issuance": "input.?issuanceDate",
    "/date_of_expiry": "input.?validUntil"
}
