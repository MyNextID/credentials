{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EUDI Personal Identification Data (PID) Claims",
    "type": "object",
    "required": ["expiry_date", "issuing_authority","issuing_country","trust_anchor"],
    "properties": {
      "family_name": {
        "type": "string"
      },
      "given_name": {
        "type": "string"
      },
      "birth_date": {
        "type": "string",
        "format": "date"
      },
  
      "place_of_birth": {
        "$ref": "#/$defs/place_of_birth"
      },
  
      "nationality": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/country_code"
        }
      },
  
      "resident_address": {
        "type": "string",
        "description": "Full address"
      },
      "resident_country": {
        "$ref": "#/$defs/country_code"
      },
      "resident_state": {
        "type": "string"
      },
      "resident_city": {
        "type": "string"
      },
      "resident_postal_code": {
        "type": "string"
      },
      "resident_street": {
        "type": "string",
        "description": "Street name, including the house number"
      },

      "personal_administrative_number": {
        "type": "string"
      },

      "portrait": {
        "type": "string",
        "contentEncoding": "base64",
        "description": "JPEG image (bstr in the mdoc)"
      },
  
      "family_name_birth": {
        "type": "string"
      },
      "given_name_birth": {
        "type": "string"
      },
      "sex": {
        "type": "integer",
        "enum": [0, 1, 2, 3, 4, 5, 6, 9],
        "description": "0 not known, 1 male, 2 female, 3 other, 4 inter, 5 diverse, 6 open, 9 not applicable"
      },
      "email_address": {
        "type": "string",
        "format": "email"
      },
  
      "mobile_phone_number": {
        "type": "string"
      },
  
      "expiry_date": {
        "type": "string",
        "format": "date"
      },  
      "issuing_authority": {
        "type": "string"
      },
  
      "issuing_country": {
        "$ref": "#/$defs/country_code"
      },
  
      "document_number": {
        "type": "string"
      },
  
      "issuing_jurisdiction": {
        "type": "string"
      },
      "issuance_date": {
        "type": "string",
        "format": "date"
      },
      "trust_anchor": {
        "type": "string",
        "format": "uri"
      }
    },
  
    "$defs": {
      "country_code": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "ISO 3166-1 alpha-2 country code"
      },
  
      "place_of_birth": {
        "type": "object",
        "properties": {
          "locality": { "type": "string" },
          "region": { "type": "string" }, 
          "country": { "$ref": "#/$defs/country_code" }
        },
        "additionalProperties": false
      }
    },
  
    "additionalProperties": false
  }