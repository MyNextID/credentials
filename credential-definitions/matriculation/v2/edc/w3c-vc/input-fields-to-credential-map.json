{
    "/displayParameter/title": "input.credentialTitle",
    "/credentialSubject/fullName": "input.?fullName",
    "/credentialSubject/dateOfBirth": "input.?dateOfBirth",
    "/credentialSubject/identifier": "[['Student number', input.?studentNumber.orValue('')]].filter(p, p[1] != '').map(p, {'id': 'urn:epass:identifier:' + uuid(), 'type': 'Identifier', 'schemeName': p[0], 'notation': p[1], 'schemeAgency': meta.?awardingBody.orValue(meta.issuer).legalName})",
    "/credentialSubject/hasClaim/id": "'urn:epass:learningEntitlement:' + uuid()",
    "/credentialSubject/hasClaim/type": "'LearningEntitlement'",
    "/credentialSubject/hasClaim/title": "input.programmeTitle",
    "/credentialSubject/hasClaim/specifiedBy": "{'id': 'urn:epass:learningEntitlementSpecification:' + uuid(), 'type': 'LearningEntitlementSpecification', 'title': input.programmeTitle, 'dcType': vocab.entitlementType['learning opportunity'], 'entitlementStatus': vocab.entitlementStatus['actual']}",
    "/credentialSubject/hasClaim/dateIssued": "input.matriculationStart",
    "/credentialSubject/hasClaim/expiryDate": "input.matriculationEnd",
    "/credentialSubject/hasClaim/additionalNote": "[['Programme status', {'current': 'current', 'withoutDegree': 'finished without degree', 'withDegree': 'finished with degree'}[input.programmeStatus]], ['ECTS', string(input.currentEcts) + ' of ' + string(input.maxEcts)], ['Deadline', input.?deadline.orValue('')]].filter(p, p[1] != '').map(p, {'id': 'urn:epass:note:' + uuid(), 'type': 'Note', 'noteLiteral': {'en': p[0] + ': ' + p[1]}})"
}
