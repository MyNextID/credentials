{
    "/credentialSubject/fullName": "input.?fullName",
    "/credentialSubject/dateOfBirth": "input.?dateOfBirth",
    "/credentialSubject/placeOfBirth": "{'id': 'urn:epass:location:' + uuid(), 'type': 'Location', 'address': {'id': 'urn:epass:address:' + uuid(), 'type': 'Address', 'countryCode': vocab.country[input.placeOfBirth.en], 'fullAddress': {'id': 'urn:epass:note:' + uuid(), 'type': 'Note', 'noteLiteral': input.fullAddress}}}",
    "/credentialSubject/hasClaim/creditReceived": "[{'id': 'urn:epass:creditPoint:' + uuid(), 'type': 'CreditPoint', 'framework': vocab.creditSystem['European Credit Transfer System'], 'point': string(input.ectsPoints)}]",
    "/credentialSubject/hasClaim/specifiedBy": "{'id': 'urn:epass:qualification:' + uuid(), 'type': 'Qualification', 'title': translations.title}"
}
