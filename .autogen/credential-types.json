  "microcredential": {
    "v1": {
      "schema": "/credential-definitions/microcredential/v1/input-fields/schema.json",
      "profiles": {
        "edc": {
          "formats": {
            "w3c-vc": {
              "schema": "/credential-definitions/microcredential/v1/edc/w3c-vc/schema.json",
              "input-fields-map": {
                "/credentialSubject/fullName": "input.fullName",
                "/credentialSubject/nationalID": "has(input.nationalId) ? optional.of({'id': 'urn:epass:legalIdentifier:' + uuid(), 'type': 'LegalIdentifier', 'notation': input.nationalId, 'spatial': vocab.country[input.nationalIdCountry.en]}) : optional.none()",
                "/credentialSubject/hasClaim/title": "input.achievementTitle",
                "/credentialSubject/hasClaim/description": "input.?achievementDescription",
                "/credentialSubject/hasClaim/provenBy/id": "'urn:epass:learningAssessment:' + uuid()",
                "/credentialSubject/hasClaim/provenBy/type": "'LearningAssessment'",
                "/credentialSubject/hasClaim/provenBy/title": "input.title",
                "/credentialSubject/hasClaim/provenBy/grade": "{'id': 'urn:epass:note:' + uuid(), 'type': 'Note', 'noteLiteral': input.gradeAchieved}",
                "/credentialSubject/hasClaim/provenBy/idVerification": "has(input.verificationMethod) ? optional.of(vocab.supervision[input.verificationMethod.en]) : optional.none()",
                "/credentialSubject/hasClaim/provenBy/awardedBy": "{'id': 'urn:epass:awardingProcess:1', 'type': 'AwardingProcess', 'awardingBody': meta.?awardingBody.orValue(meta.issuer)}",
                "/credentialSubject/hasClaim/provenBy/specifiedBy": "has(input.type) || has(input.mode) ? optional.of({'id': 'urn:epass:learningAssessmentSpecification:' + uuid(), 'type': 'LearningAssessmentSpecification', 'title': input.title, 'dcType': has(input.type) ? optional.of(vocab.assessmentType[input.type.en]) : optional.none(), 'mode': has(input.mode) ? optional.of(vocab.learningMode[input.mode.en]) : optional.none()}) : optional.none()",
                "/credentialSubject/hasClaim/specifiedBy": "{'id': 'urn:epass:qualification:' + uuid(), 'type': 'Qualification', 'title': input.achievementTitle, 'volumeOfLearning': input.?hoursOfLearning, 'creditPoint': {'id': 'urn:epass:creditPoint:' + uuid(), 'type': 'CreditPoint', 'point': input.ectsPoints, 'framework': vocab.creditSystem['European Credit Transfer System']}}",
                "/displayParameter/description": "input.awardingStatement"
              }
            }
          }
        },
        "open-badge": {
          "formats": {
            "w3c-vc": {
              "schema": "/credential-definitions/microcredential/v1/open-badge/w3c-vc/schema.json",
              "input-fields-map": {
                "/name": "input.achievementTitle[?meta.primaryLanguage].orValue(input.achievementTitle.en)",
                "/credentialSubject/achievement/name": "input.achievementTitle[?meta.primaryLanguage].orValue(input.achievementTitle.en)",
                "/credentialSubject/achievement/description": "has(input.achievementDescription) ? input.achievementDescription[?meta.primaryLanguage].orValue(input.achievementDescription.en) : input.achievementTitle[?meta.primaryLanguage].orValue(input.achievementTitle.en)",
                "/credentialSubject/achievement/achievementType": "'MicroCredential'",
                "/credentialSubject/achievement/creditsAvailable": "double(input.ectsPoints)",
                "/credentialSubject/achievement/criteria/narrative": "input.title[?meta.primaryLanguage].orValue(input.title.en)",
                "/credentialSubject/result": "[{'type': ['Result'], 'value': input.gradeAchieved[?meta.primaryLanguage].orValue(input.gradeAchieved.en)}]"
              }
            }
          }
        }
      }
    }
  },
