                "/namespace/org.iso.18013.5.1/resident_country": "input.?residentCountry",
                "/namespace/org.iso.18013.5.1/biometric_template_xx": "input.?biometricTemplateXX",
                "/namespace/org.iso.18013.5.1/family_name_national_character": "input.?familyNameNationalCharacter",
                "/namespace/org.iso.18013.5.1/given_name_national_character": "input.?givenNameNationalCharacter",
                "/namespace/org.iso.18013.5.1/signature_usual_mark": "input.?signatureUsualMark"
