{
    "/@context": "['https://www.w3.org/2018/credentials/v1', 'http://data.europa.eu/snb/model/context/edc-ap']",
    "/id": "'urn:credential:' + uuid()",
    "/type": "['VerifiableCredential', 'EuropeanDigitalCredential']",
    "/credentialSchema": "{'id': 'http://data.europa.eu/snb/model/ap/edc-generic-full', 'type': 'ShaclValidator2017'}",
    "/credentialProfiles": "vocab.credentialProfile['Generic']",
    "/issuer": "meta.issuer",
    "/issuanceDate": "now",
    "/issued": "now",
    "/validFrom": "meta.?validFrom.orValue(now)",
    "/expirationDate": "meta.?validUntil",
    "/credentialSubject/id": "'urn:epass:person:' + uuid()",
    "/credentialSubject/type": "'Person'",
    "/credentialSubject/contactPoint": "has(meta.recipientEmail) ? optional.of({'id': 'urn:epass:contactPoint:1', 'type': 'ContactPoint', 'emailAddress': {'id': 'mailto:' + meta.recipientEmail, 'type': 'Mailbox'}}) : optional.none()",
    "/credentialSubject/hasClaim/id": "'urn:epass:learningAchievement:' + uuid()",
    "/credentialSubject/hasClaim/type": "'LearningAchievement'",
    "/credentialSubject/hasClaim/title": "translations.title",
    "/credentialSubject/hasClaim/awardedBy": "{'id': 'urn:epass:awardingProcess:1', 'type': 'AwardingProcess', 'awardingBody': meta.?awardingBody.orValue(meta.issuer)}",
    "/displayParameter/id": "'urn:epass:displayParameter:' + uuid()",
    "/displayParameter/type": "'DisplayParameter'",
    "/displayParameter/title": "translations.title",
    "/displayParameter/primaryLanguage": "vocab.language[meta.primaryLanguage]",
    "/displayParameter/language": "[vocab.language[meta.primaryLanguage]]",
    "/displayParameter/individualDisplay": "has(meta.preview) ? optional.of([{'id': 'urn:epass:individualDisplay:' + uuid(), 'type': 'IndividualDisplay', 'language': vocab.language[meta.primaryLanguage], 'displayDetail': meta.preview.pages.map(p, {'id': 'urn:epass:displayDetail:' + uuid(), 'type': 'DisplayDetail', 'page': p.page, 'image': {'id': 'urn:epass:mediaObject:' + uuid(), 'type': 'MediaObject', 'content': p.content, 'contentEncoding': vocab.encoding['base64'], 'contentType': vocab.fileType[meta.preview.format]}})}]) : optional.none()"
}
