{
    "/@context": "['https://www.w3.org/ns/credentials/v2', 'https://purl.imsglobal.org/spec/ob/v3p0/context-3.0.3.json']",
    "/id": "'urn:uuid:' + uuid()",
    "/type": "['VerifiableCredential', 'OpenBadgeCredential']",
    "/name": "translations.title[?meta.primaryLanguage].orValue(translations.title.en)",
    "/issuer": "meta.issuer",
    "/validFrom": "meta.?validFrom.orValue(now)",
    "/validUntil": "meta.?validUntil",
    "/credentialSubject/type": "['AchievementSubject']",
    "/credentialSubject/identifier": "has(meta.recipientIdentity) ? optional.of([meta.recipientIdentity]) : optional.none()",
    "/credentialSubject/achievement/id": "'urn:uuid:' + uuid()",
    "/credentialSubject/achievement/type": "['Achievement']",
    "/credentialSubject/achievement/creator": "meta.?awardingBody",
    "/credentialSubject/achievement/inLanguage": "meta.primaryLanguage"
}
